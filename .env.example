# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_ACCESS_TOKEN=your-access-token

# Database Connection Strings
DATABASE_URL=postgresql://postgres.ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgresql://postgres:password@db.ref.supabase.co:5432/postgres

# API Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PLATFORM_COMMISSION_BPS=1000
DEFAULT_DELIVERY_FEE_MINOR=250000
RESERVATION_TTL_MINUTES=15
RETURN_WINDOW_DAYS=7
RESERVATION_SWEEP_INTERVAL_MS=60000
OUTBOX_INTERVAL_MS=5000
PAYOUT_RECONCILE_INTERVAL_MS=300000

# Payments are intentionally deferred. Change both modes to paystack only during
# the dedicated, sandbox-tested payment integration work.
PAYMENT_MODE=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=sellfastbuyfast://payment/callback

# Required in production before merchant-registration submissions are enabled.
# Generate a 32-byte key, then base64 encode it; never expose it to a client.
KYC_ENCRYPTION_KEY=

# Expo client (public values only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_ENABLE_MOCKS=false
EXPO_PUBLIC_PAYMENT_MODE=mock

# Admin portal Vercel project (public browser configuration only)
ADMIN_API_URL=https://your-core-api.example.com
ADMIN_SUPABASE_URL=https://your-project-ref.supabase.co
ADMIN_SUPABASE_ANON_KEY=your-public-anon-key

# Core API only: admin operations (never copy these into browser configuration)
ADMIN_REQUIRE_MFA=true
ADMIN_CURSOR_SECRET=
ADMIN_FINANCE_ENABLED=false
ADMIN_PORTAL_URL=https://your-admin.example.com
# SMTP URL includes server-side credentials; use TLS-capable SMTP.
ADMIN_SMTP_URL=
ADMIN_MAIL_FROM=

# Scheduled non-payment maintenance (Core API and Supabase Vault only)
OPERATIONS_RUNNER_SECRET=
# Hosted account confirmation/recovery used by the Expo customer app
EXPO_PUBLIC_ACCOUNT_URL=https://www.sellfastbuyfast.com
# Carrier callbacks stay unconfigured until the actual partner is connected.
# Format: {"carrier-slug":"provider-shared-secret"}; do not expose to clients.
LOGISTICS_WEBHOOK_SECRETS={}
